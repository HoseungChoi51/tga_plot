{"arm": "R-mpl-plain", "ok_run": true, "calls": [{"llm_s": 23.34, "prompt_tokens": 1194, "output_tokens": 624, "thinking_tokens": 0, "finish": "stop"}], "errors": [], "final": "import pandas as pd\nimport matplotlib.pyplot as plt\nimport os\n\n# Set Korean font\nplt.rcParams['font.family'] = 'Noto Sans CJK KR'\nplt.rcParams['axes.unicode_minus'] = False\n\nDATA_FILE = \"/home/chs/Work/tga_plot/tests/inputs/TGA.xlsx\"\nOUT_DIR = \"/home/chs/Work/tga_plot/eval/results/runs/sx/R-mpl-plain/22_r2/out\"\n\nos.makedirs(OUT_DIR, exist_ok=True)\n\n# Read all sheets from the Excel file\nxls = pd.ExcelFile(DATA_FILE)\nsheet_names = xls.sheet_names\n\nfig, axes = plt.subplots(len(sheet_names), 1, figsize=(10, 4 * len(sheet_names)), sharex=True)\n\nif len(sheet_names) == 1:\n    axes = [axes]\n\ncolors_y1 = ['blue', 'red', 'purple']\ncolor_y2 = 'green'  # User requested green for y2 line and label\n\nfor idx, sheet_name in enumerate(sheet_names):\n    df = pd.read_excel(DATA_FILE, sheet_name=sheet_name)\n    \n    # Identify columns based on the preview info\n    x_col = 'Temperature'\n    y1_col = 'Weight(%)'\n    y2_col = 'D.W(%/C)'\n    \n    ax1 = axes[idx]\n    \n    # Plot Weight (%) on primary axis (left)\n    color1 = colors_y1[idx % len(colors_y1)]\n    ax1.plot(df[x_col], df[y1_col], color=color1, label='Weight (%)')\n    ax1.set_ylabel('Weight (%)', color=color1)\n    ax1.tick_params(axis='y', labelcolor=color1)\n    ax1.set_xlabel('Temperature (°C)')\n    ax1.grid(True, linestyle='--', alpha=0.5)\n    \n    # Create secondary axis for D.W (%/C)\n    ax2 = ax1.twinx()\n    ax2.plot(df[x_col], df[y2_col], color=color_y2, label='D.W (%/C)', linestyle='--')\n    ax2.set_ylabel('D.W (%/C)', color=color_y2)\n    ax2.tick_params(axis='y', labelcolor=color_y2)\n    \n    # Title\n    ax1.set_title(f'TGA - {sheet_name}')\n    \n    # Combine legends\n    lines_1, labels_1 = ax1.get_legend_handles_labels()\n    lines_2, labels_2 = ax2.get_legend_handles_labels()\n    ax1.legend(lines_1 + lines_2, labels_1 + labels_2, loc='best')\n\nplt.tight_layout()\n\noutput_path = os.path.join(OUT_DIR, \"tga_plots.png\")\nplt.savefig(output_path, dpi=300, bbox_inches='tight')\nplt.close()\n", "seconds": 24.52, "exec_seconds": 1.17, "figures": [{"engine": "matplotlib", "size_in": [10.0, 12.0], "dpi": 300.0, "title": {"text": "TGA - 1006R1-V normal", "size": 12.0, "color": "#000000"}, "panels": [{"x": {"min": -13.5, "max": 943.5, "scale": "linear", "inverted": false, "ticks": [0.0, 200.0, 400.0, 600.0, 800.0], "step": 200.0, "label": "Temperature (°C)", "label_size": 10.0, "label_color": "#000000", "tick_size": null, "tick_color": null, "tick_direction": "out", "minor": 0}, "y1": {"min": 3.372095, "max": 104.611805, "scale": "linear", "inverted": false, "ticks": [20.0, 40.0, 60.0, 80.0, 100.0], "step": 20.0, "label": "Weight (%)", "label_size": 10.0, "label_color": "#0000ff", "tick_size": 10.0, "tick_color": "#0000ff", "tick_direction": "out", "minor": 0}, "y2": {"min": -1.0783713849999998, "max": 0.053999084999999995, "scale": "linear", "inverted": false, "ticks": [-1.0000000000000002, -0.8000000000000002, -0.6000000000000001, -0.40000000000000013, -0.20000000000000018, 0.0], "step": 0.2, "label": "D.W (%/C)", "label_size": 10.0, "label_color": "#008000", "tick_size": 10.0, "tick_color": "#008000", "tick_direction": "out", "minor": 0}, "lines": [{"axis": "y1", "kind": "line", "color": "#0000ff", "width": 1.5, "style": "solid", "marker": false, "n": 871, "x_range": [30.0, 900.0], "y_range": [7.9739, 100.01], "label": "Weight (%)"}, {"axis": "y2", "kind": "line", "color": "#008000", "width": 1.5, "style": "dashed", "marker": false, "n": 871, "x_range": [30.0, 900.0], "y_range": [-1.0269, 0.0025277], "label": "D.W (%/C)"}], "spans": [], "vlines": [], "hlines": [], "fills": 0, "grid": true, "title": "TGA - 1006R1-V normal"}, {"x": {"min": -13.5, "max": 943.5, "scale": "linear", "inverted": false, "ticks": [0.0, 200.0, 400.0, 600.0, 800.0], "step": 200.0, "