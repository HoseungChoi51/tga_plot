{"arm": "R-mpl-plain", "ok_run": true, "calls": [{"llm_s": 23.58, "prompt_tokens": 1186, "output_tokens": 738, "thinking_tokens": 0, "finish": "stop"}], "errors": [], "final": "import pandas as pd\nimport matplotlib.pyplot as plt\nimport os\n\n# 설정\nDATA_FILE = \"/home/chs/Work/tga_plot/tests/inputs/TGA.xlsx\"\nOUT_DIR = \"/home/chs/Work/tga_plot/eval/results/runs/sx/R-mpl-plain/06_r3/out\"\n\n# 한글 폰트 설정\nplt.rcParams['font.family'] = 'Noto Sans CJK KR'\nplt.rcParams['axes.unicode_minus'] = False\n\n# 출력 디렉토리가 없으면 생성\nos.makedirs(OUT_DIR, exist_ok=True)\n\n# Excel 파일 읽기 (모든 시트)\nxls = pd.ExcelFile(DATA_FILE)\nsheet_names = xls.sheet_names\n\n# 각 시트별로 TGA 데이터 추출 및 플롯 그리기\nfig, axes = plt.subplots(len(sheet_names), 1, figsize=(8, 4 * len(sheet_names)), sharex=True)\n\n# 만약 시트가 하나라면 axes가 array가 아니므로 리스트로 변환\nif len(sheet_names) == 1:\n    axes = [axes]\n\nfor idx, sheet_name in enumerate(sheet_names):\n    df = pd.read_excel(DATA_FILE, sheet_name=sheet_name)\n    \n    # 컬럼 이름 확인 (데이터 미리보기 기준)\n    # B: Temperature, C: Weight(%), D: D.W(%/C)\n    temp_col = 'Temperature'\n    weight_col = 'Weight(%)'\n    dtg_col = 'D.W(%/C)'\n    \n    # 데이터 준비\n    x = df[temp_col]\n    y1 = df[weight_col]\n    y2 = df[dtg_col]\n    \n    ax = axes[idx]\n    \n    # TGA 곡선 (Weight %) - 왼쪽 Y축\n    line1, = ax.plot(x, y1, color='blue', label='TGA')\n    ax.set_ylabel('Weight (%)', color='blue')\n    ax.tick_params(axis='y', labelcolor='blue')\n    \n    # DTG 곡선 (D.W %/C) - 오른쪽 Y축\n    ax2 = ax.twinx()\n    line2, = ax2.plot(x, y2, color='red', linestyle='--', label='DTG')\n    ax2.set_ylabel('DTG (%/°C)', color='red')\n    ax2.tick_params(axis='y', labelcolor='red')\n    \n    # X축 라벨은 마지막 서브플롯에만 표시하거나 모두 표시하되 공유하므로 마지막만 강조 가능\n    # 여기서는 각 서브플롯마다 제목으로 구분\n    ax.set_title(f'Sample: {sheet_name}')\n    \n    # 격자 켜기 (요청 사항)\n    ax.grid(True, which='both', linestyle=':', linewidth=0.5, alpha=0.7)\n    \n    # 범례 제거 (요청 사항)\n    # 이미 plot에 label을 넣었지만 legend 호출하지 않으면 안 나옴. \n    # 단, twin axis인 경우 주의 필요. 명시적으로 legend를 부르지 않음.\n\n# 전체 X축 레이블\naxes[-1].set_xlabel('Temperature (°C)')\n\n# 레이아웃 조정\nplt.tight_layout()\n\n# 저장\noutput_path = os.path.join(OUT_DIR, \"tga_plot.png\")\nplt.savefig(output_path, dpi=300, bbox_inches='tight')\nplt.close()\n", "seconds": 24.68, "exec_seconds": 1.1, "figures": [{"engine": "matplotlib", "size_in": [8.0, 12.0], "dpi": 300.0, "title": {"text": "Sample: 1006R1-V normal", "size": 12.0, "color": "#000000"}, "panels": [{"x": {"min": -13.5, "max": 943.5, "scale": "linear", "inverted": false, "ticks": [0.0, 200.0, 400.0, 600.0, 800.0], "step": 200.0, "label": "", "label_size": 10.0, "label_color": "#000000", "tick_size": null, "tick_color": null, "tick_direction": "out", "minor": 0}, "y1": {"min": 3.372095, "max": 104.611805, "scale": "linear", "inverted": false, "ticks": [20.0, 40.0, 60.0, 80.0, 100.0], "step": 20.0, "label": "Weight (%)", "label_size": 10.0, "label_color": "#0000ff", "tick_size": 10.0, "tick_color": "#0000ff", "tick_direction": "out", "minor": 0}, "y2": {"min": -1.0783713849999998, "max": 0.053999084999999995, "scale": "linear", "inverted": false, "ticks": [-1.0000000000000002, -0.8000000000000002, -0.6000000000000001, -0.40000000000000013, -0.20000000000000018, 0.0], "step": 0.2, "label": "DTG (%/°C)", "label_size": 10.0, "label_color": "#ff0000", "tick_size": 10.0, "tick_color": "#ff0000", "tick_direction": "out", "minor": 0}, "lines": [{"axis": "y1", "kind": "line", "color": "#0000ff", "width": 1.5, "style": "solid", "marker": false, "n": 871, "x_range": [30.0, 900.0], "y_range": [7.9739, 100.01], "label": "TGA"}, {"axis": "y2", "kind": "line", "color": "#ff0000", "width": 1.5, "style": "dashed", "marker": false, "n": 871, "x_range": [30.0, 900.0], "y_range": [-1.0269, 0.0025277], "label": "DTG"}], "spans": [], "vlines": [], "hlines": [], "fills": 0, "grid": true, "title": "Sample: 1006R1-V normal"}, {"x": {"min": -13.5, "max": 943.5, "scale": "linear", "inverted": false, "ticks": [0.0, 200.0, 400