     "reply": "```json\n{\n  \"file\": \"data/run_log.xlsx\",\n  \"sheet\": \"런로그\",\n  \"chart\": \"bar\",\n  \"x\": \"반응기\",\n  \"y\": \"count\",\n  \"by\": \"등급 (A/B/C)\",\n  \"stack\": true,\n  \"asks\": [\n    {\"ask\": \"반응기별 등급 구성비 막대\", \"how\": \"key\"},\n    {\"ask\": \"합이 100%가 되게 (정규화)\", \"how\": \"code\"}\n  ],\n  \"code\": \"import numpy as np\\nfrom collections import defaultdict\\ncats = sorted(df['반응기'].unique())\\nsers = df['등급 (A/B/C)'].unique()\\ndata_arr = np.zeros((len(cats), len(sers)))\\nfor i, c in enumerate(cats):\\n    for j, s in enumerate(sers):\\n        data_arr[i, j] = ((df['반응기'] == c) & (df['등급 (A/B/C)'] == s)).sum()\\ntotals = data_arr.sum(axis=1, keepdims=True)\\npct = np.divide(data_arr, totals, out=np.zeros_like(data_arr), where=totals!=0) * 100\\nax.clear()\\nbottom = np.zeros(len(cats))\\nfor j, s in enumerate(sers):\\n    ax.bar(cats, pct[:, j], bottom=bottom, label=s)\\n    bottom += pct[:, j]\\nax.set_xlabel('반응기')\\nax.set_ylabel('구성비 (%)')\\nax.legend(title='등급', loc='best')\\nax.set_ylim(0, 105)\"\n}\n```",
