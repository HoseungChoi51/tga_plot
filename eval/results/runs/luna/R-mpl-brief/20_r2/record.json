e_weight = weight.loc[residue_idx]\n    ax1.plot(residue_temp, residue_weight, \"o\", color=\"#1f4e9c\", markersize=5, zorder=3)\n    ax1.annotate(\n        f\"Residue {residue_weight:.1f}%\",\n        (residue_temp, residue_weight),\n        xytext=(8, 8),\n        textcoords=\"offset points\",\n        color=\"#1f4e9c\",\n    )\n\n    peak_candidates = data[temperature > 150]\n    if not peak_candidates.empty:\n        peak_idx = (-peak_candidates[dtg_col]).idxmax()\n        peak_temp = temperature.loc[peak_idx]\n        peak_value = dtg_up.loc[peak_idx]\n        ax2.plot(peak_temp, peak_value, \"o\", color=\"#c0392b\", markersize=5, zorder=3)\n        ax2.annotate(\n            f\"{peak_temp:.0f} °C\",\n            (peak_temp, peak_value),\n            xytext=(8, 8),\n            textcoords=\"offset points\",\n            color=\"#c0392b\",\n        )\n\n    ax1.set_title(sheet_name)\n    ax1.grid(True, alpha=0.3)\n\n    lines1, labels1 = ax1.get_legend_handles_labels()\n    lines2, labels2 = ax2.get_legend_handles_labels()\n    ax1.legend(lines1 + lines2, labels1 + labels2, loc=\"center left\")\n\n    fig.tight_layout()\n    safe_name = \"\".join(c if c.isalnum() or c in \"-_.\" else \"_\" for c in sheet_name)\n    fig.savefig(out_dir / f\"{safe_name}.png\", dpi=300, bbox_inches=\"tight\")\n    plt.close(fig)\n", "seconds": 18.42, "exec_seconds": 0.81, "figures": [{"engine": "matplotlib", "size_in": [9.0, 6.0], "dpi": 300.0, "title": {"text": "1006R1-V normal", "size": 12.0, "color": "#000000"}, "panels": [{"x": {"min": -13.5, "max": 943.5, "scale": "linear", "inverted": false, "ticks": [0.0, 200.0, 400.0, 600.0, 800.0], "step": 200.0, "label": "Temperature (°C)", "label_size": 10.0, "label_color": "#000000", "tick_size": 10.0, "tick_color": "#000000", "tick_direction": "out", "minor": 0}, "y1": {"min": 3.372095, "max": 104.611805, "scale": "linear", "inverted": false, "ticks": [20.0, 40.0, 60.0, 80.0, 100.0], "step": 20.0, "label": "Weight (%)", "label_size": 1