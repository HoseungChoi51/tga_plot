ivative.notna()\n        ax2 = ax1.twinx()\n        ax2.plot(\n            temperature[valid_derivative],\n            derivative[valid_derivative],\n            color=\"tab:red\",\n            linewidth=1.5,\n        )\n        ax2.set_ylabel(\"D.W (%/°C)\", color=\"tab:red\")\n        ax2.tick_params(axis=\"y\", labelcolor=\"tab:red\")\n\n    ax1.set_title(sheet_name)\n    fig.tight_layout()\n\n    safe_name = \"\".join(\n        character if character.isalnum() or character in \"._- \" else \"_\"\n        for character in sheet_name\n    ).strip()\n    fig.savefig(out_dir / f\"{safe_name}.png\", dpi=300, bbox_inches=\"tight\")\n    plt.close(fig)\n", "seconds": 13.03, "exec_seconds": 0.76, "figures": [{"engine": "matplotlib", "size_in": [9.0, 6.0], "dpi": 300.0, "title": {"text": "1006R1-V normal", "size": 12.0, "color": "#000000"}, "panels": [{"x": {"min": -13.5, "max": 943.5, "scale": "linear", "inverted": false, "ticks": [0.0, 200.0, 400.0, 600.0, 800.0], "step": 200.0, "label": "Temperature (°C)", "label_size": 10.0, "label_color": "#000000", "tick_size": 10.0, "tick_color": "#000000", "tick_direction": "out", "minor": 0}, "y1": {"min": 3.372095, "max": 104.611805, "scale": "linear", "inverted": false, "ticks": [20.0, 40.0, 60.0, 80.0, 100.0], "step": 20.0, "label": "Weight (%)", "label_size": 10.0, "label_color": "#1f77b4", "tick_size": 10.0, "tick_color": "#1f77b4", "tick_direction": "out", "minor": 0}, "y2": {"min": -1.0783713849999998, "max": 0.053999084999999995, "scale": "linear", "inverted": false, "ticks": [-1.0000000000000002, -0.8000000000000002, -0.6000000000000001, -0.40000000000000013, -0.20000000000000018, 0.0], "step": 0.2, "label": "D.W (%/°C)", "label_size": 10.0, "label_color": "#d62728", "tick_size": 10.0, "tick_color": "#d62728", "tick_direction": "out", "minor": 0}, "lines": [{"axis": "y1", "kind": "line", "color": "#1f77b4", "width": 1.8, "style": "solid", "marker": false, "n": 871, "x_range": [30.0, 900.0], "y_range": [7.9739, 100.01], 