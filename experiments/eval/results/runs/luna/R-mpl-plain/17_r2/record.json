{"arm": "R-mpl-plain", "ok_run": true, "calls": [{"llm_s": 14.03, "prompt_tokens": 1087, "output_tokens": 712, "thinking_tokens": 0, "finish": "stop", "refused": 0}], "errors": [], "final": "from pathlib import Path\n\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport pandas as pd\n\nDATA_FILE = Path(\"/home/chs/Work/tga_plot/tests/inputs/TGA.xlsx\")\nOUT_DIR = Path(\"/home/chs/Work/tga_plot/eval/results/runs/luna/R-mpl-plain/17_r2/out\")\n\n# Korean-capable font\nplt.rcParams[\"font.family\"] = \"Noto Sans CJK KR\"\nplt.rcParams[\"axes.unicode_minus\"] = False\n\nOUT_DIR.mkdir(parents=True, exist_ok=True)\n\nsheets = pd.read_excel(DATA_FILE, sheet_name=None)\n\nfor sheet_name, df in sheets.items():\n    # Normalize column names for matching while preserving original data.\n    columns = {str(col).strip().lower(): col for col in df.columns}\n\n    def find_column(fragment):\n        for normalized, original in columns.items():\n            if fragment in normalized:\n                return original\n        return None\n\n    temperature_col = find_column(\"temperature\")\n    weight_col = find_column(\"weight\")\n    derivative_col = find_column(\"d.w\")\n\n    if temperature_col is None or weight_col is None:\n        # Skip sheets that do not have the expected TGA columns.\n        continue\n\n    temperature = pd.to_numeric(df[temperature_col], errors=\"coerce\")\n    weight = pd.to_numeric(df[weight_col], errors=\"coerce\")\n\n    fig, ax1 = plt.subplots(figsize=(8, 5))\n    ax1.plot(temperature, weight, color=\"tab:blue\", linewidth=1.6, label=\"Weight (%)\")\n    ax1.set_xlabel(\"Temperature (°C)\")\n    ax1.set_ylabel(\"Weight (%)\", color=\"tab:blue\")\n    ax1.tick_params(axis=\"y\", labelcolor=\"tab:blue\")\n    ax1.grid(True, linestyle=\"--\", linewidth=0.6, alpha=0.5)\n\n    if derivative_col is not None:\n        derivative = pd.to_numeric(df[derivative_col], errors=\"coerce\")\n        ax2 = ax1.twinx()\n        ax2.plot(\n            temperature,\n            derivative,\n            color=\"tab:red\",\n            linewidth=1.2,\n            label=\"D.W (%/°C)\",\n        )\n        ax2.set_ylabel(\"D.W (%/°C)\", color=\"tab:red\")\n        ax2.tick_params(axis=\"y\", labelcolor=\"tab:red\")\n\n        lines1, labels1 = ax1.get_legend_handles_labels()\n        lines2, labels2 = ax2.get_legend_handles_labels()\n        ax1.legend(lines1 + lines2, labels1 + labels2, loc=\"best\", frameon=False)\n    else:\n        ax1.legend(loc=\"best\", frameon=False)\n\n    ax1.set_title(sheet_name)\n    fig.tight_layout()\n\n    safe_name = \"\".join(\n        char if char.isalnum() or char in (\"-\", \"_\") else \"_\"\n        for char in str(sheet_name)\n    )\n    fig.savefig(OUT_DIR / f\"{safe_name}.png\", dpi=600, bbox_inches=\"tight\")\n    plt.close(fig)\n", "seconds": 15.3, "exec_seconds": 1.27, "figures": [{"engine": "matplotlib", "size_in": [8.0, 5.0], "dpi": 600.0, "title": {"text": "1006R1-V normal", "size": 12.0, "color": "#000000"}, "panels": [{"x": {"min": -13.5, "max": 943.5, "scale": "linear", "inverted": false, "ticks": [0.0, 200.0, 400.0, 600.0, 800.0], "step": 200.0, "label": "Temperature (°C)", "label_size": 10.0, "label_color": "#000000", "tick_size": 10.0, "tick_color": "#000000", "tick_direction": "out", "minor": 0}, "y1": {"min": 3.372095, "max": 104.611805, "scale": "linear", "inverted": false, "ticks": [20.0, 40.0, 60.0, 80.0, 100.0], "step": 20.0, "label": "Weight (%)", "label_size": 10.0, "label_color": "#1f77b4", "tick_size": 10.0, "tick_color": "#1f77b4", "tick_direction": "out", "minor": 0}, "y2": {"min": -1.0783713849999998, "max": 0.053999084999999995, "scale": "linear", "inverted": false, "ticks": [-1.0000000000000002, -0.8000000000000002, -0.6000000000000001, -0.40000000000000013, -0.20000000000000018, 0.0], "step": 0.2, "label": "D.W (%/°C)", "label_size": 10.0, "label_color": "#d62728", "tick_size": 10.0, "tick_color": "#d62728", "tick_direction": "out",