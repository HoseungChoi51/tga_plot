{"arm": "R-mpl-plain", "ok_run": true, "calls": [{"llm_s": 12.49, "prompt_tokens": 1089, "output_tokens": 627, "thinking_tokens": 0, "finish": "stop", "refused": 0}], "errors": [], "final": "from pathlib import Path\n\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom matplotlib import font_manager\n\nDATA_FILE = Path(\"/home/chs/Work/tga_plot/tests/inputs/TGA.xlsx\")\nOUT_DIR = Path(\"/home/chs/Work/tga_plot/eval/results/runs/luna/R-mpl-plain/22_r2/out\")\n\n# 한글 표시를 위한 글꼴 설정\navailable_fonts = {font.name for font in font_manager.fontManager.ttflist}\nif \"Noto Sans CJK KR\" in available_fonts:\n    plt.rcParams[\"font.family\"] = \"Noto Sans CJK KR\"\nplt.rcParams[\"axes.unicode_minus\"] = False\n\nOUT_DIR.mkdir(parents=True, exist_ok=True)\n\nsheets = pd.read_excel(DATA_FILE, sheet_name=None)\n\nfor sheet_name, df in sheets.items():\n    df.columns = [str(column).strip() for column in df.columns]\n\n    temperature_col = next(\n        (col for col in df.columns if \"temperature\" in col.lower()), None\n    )\n    weight_col = next(\n        (col for col in df.columns if \"weight\" in col.lower()), None\n    )\n    derivative_col = next(\n        (col for col in df.columns if \"d.w\" in col.lower() or \"dw\" in col.lower()),\n        None,\n    )\n\n    if not all((temperature_col, weight_col, derivative_col)):\n        raise ValueError(f\"시트 '{sheet_name}'에서 필요한 열을 찾지 못했습니다.\")\n\n    x = pd.to_numeric(df[temperature_col], errors=\"coerce\")\n    weight = pd.to_numeric(df[weight_col], errors=\"coerce\")\n    derivative = pd.to_numeric(df[derivative_col], errors=\"coerce\")\n    valid = x.notna() & weight.notna() & derivative.notna()\n\n    fig, ax1 = plt.subplots(figsize=(9, 6))\n    ax1.plot(x[valid], weight[valid], color=\"tab:blue\", linewidth=1.8)\n    ax1.set_xlabel(\"Temperature (°C)\")\n    ax1.set_ylabel(\"Weight (%)\", color=\"tab:blue\")\n    ax1.tick_params(axis=\"y\", labelcolor=\"tab:blue\")\n    ax1.grid(True, linestyle=\"--\", alpha=0.35)\n\n    ax2 = ax1.twinx()\n    ax2.plot(x[valid], derivative[valid], color=\"green\", linewidth=1.8)\n    ax2.set_ylabel(\"D.W. (%/°C)\", color=\"green\")\n    ax2.tick_params(axis=\"y\", labelcolor=\"green\")\n\n    ax1.set_title(sheet_name)\n    fig.tight_layout()\n\n    safe_name = \"\".join(\n        character if character.isalnum() or character in \" -_.\" else \"_\"\n        for character in sheet_name\n    ).strip()\n    fig.savefig(OUT_DIR / f\"{safe_name}.png\", dpi=300, bbox_inches=\"tight\")\n    plt.close(fig)\n", "seconds": 13.24, "exec_seconds": 0.75, "figures": [{"engine": "matplotlib", "size_in": [9.0, 6.0], "dpi": 300.0, "title": {"text": "1006R1-V normal", "size": 12.0, "color": "#000000"}, "panels": [{"x": {"min": -13.5, "max": 943.5, "scale": "linear", "inverted": false, "ticks": [0.0, 200.0, 400.0, 600.0, 800.0], "step": 200.0, "label": "Temperature (°C)", "label_size": 10.0, "label_color": "#000000", "tick_size": 10.0, "tick_color": "#000000", "tick_direction": "out", "minor": 0}, "y1": {"min": 3.372095, "max": 104.611805, "scale": "linear", "inverted": false, "ticks": [20.0, 40.0, 60.0, 80.0, 100.0], "step": 20.0, "label": "Weight (%)", "label_size": 10.0, "label_color": "#1f77b4", "tick_size": 10.0, "tick_color": "#1f77b4", "tick_direction": "out", "minor": 0}, "y2": {"min": -1.0783713849999998, "max": 0.053999084999999995, "scale": "linear", "inverted": false, "ticks": [-1.0000000000000002, -0.8000000000000002, -0.6000000000000001, -0.40000000000000013, -0.20000000000000018, 0.0], "step": 0.2, "label": "D.W. (%/°C)", "label_size": 10.0, "label_color": "#008000", "tick_size": 10.0, "tick_color": "#008000", "tick_direction": "out", "minor": 0}, "lines": [{"axis": "y1", "kind": "line", "color": "#1f77b4", "width": 1.8, "style": "solid", "marker": false, "n": 871, "x_range": [30.0, 900.0], "y_range": [7.9739, 100.01], "label": ""}, {"axis": "y2", "kind": "line", "color": "#008000", "width": 1.8, "style": "solid", "marker": false, "n": 871, "x_ra