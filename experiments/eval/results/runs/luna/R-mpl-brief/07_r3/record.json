_value),\n            xytext=(7, 8),\n            textcoords=\"offset points\",\n            color=\"#c0392b\",\n        )\n\n    ax1.set_title(sheet_name)\n    ax1.set_xlabel(\"Temperature (°C)\")\n    ax1.set_ylabel(\"Weight (%)\", color=\"#1f4e9c\")\n    ax2.set_ylabel(\"DTG (%/°C)\", color=\"#c0392b\")\n    ax1.tick_params(axis=\"y\", labelcolor=\"#1f4e9c\")\n    ax2.tick_params(axis=\"y\", labelcolor=\"#c0392b\")\n\n    ax1.legend(\n        [line1, line2],\n        [line1.get_label(), line2.get_label()],\n        loc=\"upper right\",\n        fontsize=9,\n    )\n\n    fig.tight_layout()\n    safe_name = \"\".join(\n        char if char.isalnum() or char in \"-_ \" else \"_\" for char in sheet_name\n    ).strip()\n    fig.savefig(OUT_DIR / f\"{safe_name}.png\", dpi=300, bbox_inches=\"tight\")\n    plt.close(fig)\n", "seconds": 15.48, "exec_seconds": 0.76, "figures": [{"engine": "matplotlib", "size_in": [8.0, 5.0], "dpi": 300.0, "title": {"text": "1006R1-V normal", "size": 12.0, "color": "#000000"}, "panels": [{"x": {"min": -13.5, "max": 943.5, "scale": "linear", "inverted": false, "ticks": [0.0, 200.0, 400.0, 600.0, 800.0], "step": 200.0, "label": "Temperature (°C)", "label_size": 10.0, "label_color": "#000000", "tick_size": 10.0, "tick_color": "#000000", "tick_direction": "out", "minor": 0}, "y1": {"min": 3.372095, "max": 104.611805, "scale": "linear", "inverted": false, "ticks": [20.0, 40.0, 60.0, 80.0, 100.0], "step": 20.0, "label": "Weight (%)", "label_size": 10.0, "label_color": "#1f4e9c", "tick_size": 10.0, "tick_color": "#1f4e9c", "tick_direction": "out", "minor": 0}, "y2": {"min": -0.053999084999999995, "max": 1.0783713849999998, "scale": "linear", "inverted": false, "ticks": [0.0, 0.2, 0.4000000000000001, 0.6000000000000001, 0.8, 1.0000000000000002], "step": 0.2, "label": "DTG (%/°C)", "label_size": 10.0, "label_color": "#c0392b", "tick_size": 10.0, "tick_color": "#c0392b", "tick_direction": "out", "minor": 0}, "lines": [{"axis": "y1", "kind": "line", "