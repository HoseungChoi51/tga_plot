\"#c0392b\")\n    ax1.grid(True, alpha=0.3)\n\n    residue_index = int(np.argmin(np.abs(temperature - 800)))\n    ax1.scatter(\n        temperature[residue_index],\n        weight[residue_index],\n        color=\"#1f4e9c\",\n        zorder=5,\n    )\n    ax1.annotate(\n        f\"Residue {weight[residue_index]:.1f}%\",\n        (temperature[residue_index], weight[residue_index]),\n        xytext=(8, 8),\n        textcoords=\"offset points\",\n        color=\"#1f4e9c\",\n    )\n\n    eligible = np.flatnonzero(temperature > 150)\n    if eligible.size:\n        peak_index = int(eligible[np.argmax(dtg_up[eligible])])\n        ax2.scatter(temperature[peak_index], dtg_up[peak_index], color=\"#c0392b\", zorder=5)\n        ax2.annotate(\n            f\"{temperature[peak_index]:.0f} °C\",\n            (temperature[peak_index], dtg_up[peak_index]),\n            xytext=(8, 8),\n            textcoords=\"offset points\",\n            color=\"#c0392b\",\n        )\n\n    ax1.legend([weight_line, dtg_line], [\"Weight (%)\", \"DTG (%/°C)\"], loc=\"center left\")\n    fig.tight_layout()\n\n    output_path = OUT_DIR / f\"{sheet_name}.png\"\n    fig.savefig(output_path, dpi=600, bbox_inches=\"tight\")\n    plt.close(fig)\n", "seconds": 17.69, "exec_seconds": 1.28, "figures": [{"engine": "matplotlib", "size_in": [8.0, 5.0], "dpi": 600.0, "title": {"text": "1006R1-V normal", "size": 12.0, "color": "#000000"}, "panels": [{"x": {"min": -13.5, "max": 943.5, "scale": "linear", "inverted": false, "ticks": [0.0, 200.0, 400.0, 600.0, 800.0], "step": 200.0, "label": "Temperature (°C)", "label_size": 10.0, "label_color": "#000000", "tick_size": 10.0, "tick_color": "#000000", "tick_direction": "out", "minor": 0}, "y1": {"min": 3.372095, "max": 104.611805, "scale": "linear", "inverted": false, "ticks": [20.0, 40.0, 60.0, 80.0, 100.0], "step": 20.0, "label": "Weight (%)", "label_size": 10.0, "label_color": "#1f4e9c", "tick_size": 10.0, "tick_color": "#1f4e9c", "tick_direction": "out", "minor": 0}, 