egend(lines, labels, loc='best')\n\n# Set common x-label\naxes[-1].set_xlabel('Temperature (°C)')\n\nplt.tight_layout()\noutput_path = os.path.join(OUT_DIR, \"tga_plots.png\")\nplt.savefig(output_path, dpi=300)\nplt.close()\n", "seconds": 21.15, "exec_seconds": 1.04, "figures": [{"engine": "matplotlib", "size_in": [8.0, 12.0], "dpi": 300.0, "title": {"text": "TGA/DTG Analysis - 1006R1-V normal", "size": 15.6, "color": "#808080"}, "panels": [{"x": {"min": -13.5, "max": 943.5, "scale": "linear", "inverted": false, "ticks": [0.0, 200.0, 400.0, 600.0, 800.0], "step": 200.0, "label": "", "label_size": 13.0, "label_color": "#808080", "tick_size": null, "tick_color": null, "tick_direction": "out", "minor": 0}, "y1": {"min": 3.372095, "max": 104.611805, "scale": "linear", "inverted": false, "ticks": [20.0, 40.0, 60.0, 80.0, 100.0], "step": 20.0, "label": "Weight (%)", "label_size": 13.0, "label_color": "#0000ff", "tick_size": 13.0, "tick_color": "#0000ff", "tick_direction": "out", "minor": 0}, "y2": {"min": -1.0783713849999998, "max": 0.053999084999999995, "scale": "linear", "inverted": false, "ticks": [-1.0000000000000002, -0.8000000000000002, -0.6000000000000001, -0.40000000000000013, -0.20000000000000018, 0.0], "step": 0.2, "label": "dW/dT (%/°C)", "label_size": 13.0, "label_color": "#ff0000", "tick_size": 13.0, "tick_color": "#ff0000", "tick_direction": "out", "minor": 0}, "lines": [{"axis": "y1", "kind": "line", "color": "#0000ff", "width": 1.5, "style": "solid", "marker": false, "n": 871, "x_range": [30.0, 900.0], "y_range": [7.9739, 100.01], "label": "TGA"}, {"axis": "y2", "kind": "line", "color": "#ff0000", "width": 1.5, "style": "solid", "marker": false, "n": 871, "x_range": [30.0, 900.0], "y_range": [-1.0269, 0.0025277], "label": "DTG"}], "spans": [], "vlines": [], "hlines": [], "fills": 0, "grid": false, "title": "TGA/DTG Analysis - 1006R1-V normal"}, {"x": {"min": -13.5, "max": 943.5, "scale": "linear", "inverted": false, "ticks": [0.0, 200.0, 400.0, 600.0, 800.