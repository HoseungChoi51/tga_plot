{
 "file": "data/run_log.xlsx",
 "sheet": "런로그",
 "chart": "line",
 "x": {
  "col": "일자",
  "period": "day"
 },
 "y": {
  "col": "누적생산량_kg",
  "agg": "sum"
 },
 "by": "반응기",
 "data_code": "df['생산량_kg'] = df['생산속도 (g/h)'] * df['가동시간 (h)'] / 1000; df['누적생산량_kg'] = df.groupby('반응기')['생산량_kg'].cumsum()",
 "asks": [
  {
   "ask": "Cumulative production per reactor over time",
   "how": "key"
  },
  {
   "ask": "daily resolution",
   "how": "key"
  },
  {
   "ask": "one line per reactor",
   "how": "key"
  }
 ],
 "output": {
