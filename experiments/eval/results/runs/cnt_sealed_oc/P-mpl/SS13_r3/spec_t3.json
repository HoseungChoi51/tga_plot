{
 "file": "data/run_log.xlsx",
 "sheet": "런로그",
 "chart": "line",
 "x": {
  "col": "체류시간 (s)",
  "bins": {
   "width": 0.25,
   "min": 2.5,
   "max": 6.75
  },
  "label": "Bin Midpoint"
 },
 "y": {
  "col": "CNT수율 (g/g-cat)",
  "agg": "mean"
 },
 "by": "촉매로트_그룹",
 "data_code": "df['촉매로트_그룹'] = df['촉매로트'].apply(lambda x: 'old' if x in ['FC-2602', 'FC-2603', 'FC-2604', 'FC-2605'] else 'new')",
 "filter": [
  "cnt >= 10"
 ],
 "asks": [
  {
