     "reply": "```python\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport numpy as np\nfrom scipy import stats\nimport os\n\n# Set Korean font\nplt.rcParams[\"font.family\"] = \"Noto Sans CJK KR\"\n\n# Define output directory\nOUT_DIR = \"out\"\nos.makedirs(OUT_DIR, exist_ok=True)\n\n# Read data\nfile_path = \"data/run_log.xlsx\"\nsheet_name = \"런로그\"\n\ntry:\n    df = pd.read_excel(file_path, sheet_name=sheet_name)\nexcept Exception as e:\n    print(f\"Error reading file: {e}\")\n    # Create empty dataframe with expected columns to prevent crash if file structure varies slightly in testing\n    cols = ['잔류금속 (wt%)', 'IG/ID', '등급 (A/B/C)']\n    df = pd.DataFrame(columns=cols)\n\n# Clean column names just in case there are extra spaces or formatting issues based on preview\n# The preview shows headers like 'S 잔류금속 (wt%)' and 'U IG/ID'. \n# pandas usually reads the header text. Let's assume standard header reading.\n# If the first row contains units separately, we might need skiprows, but preview says '시트 2개' and lists headers directly.\n# Looking at typical Excel structures for this kind of request, headers are likely in row 1.\n\n# Filter out Grade C\n# Identify correct column names from the DataFrame\ncol_metal = None\ncol_raman = None\ncol_grade = None\n\nfor col in df.columns:\n    if '잔류금속' in str(col):\n        col_metal = col\n    elif 'IG/ID' in str(col):\n        col_raman = col\n    elif '등급' in str(col):\n        col_grade = col\n\nif not all([col_metal, col_raman, col_grade]):\n    raise ValueError(\"Could not find required columns in the dataset\")\n\ndf_filtered = df[df[col_grade] != 'C'].dropna(subset=[col_metal, col_raman])\n\nx_data = df_filtered[col_metal].values\ny_data = df_filtered[col_raman].values\n\n# Perform linear regression\nslope, intercept, r_value, p_value, std_err = stats.linregress(x_data, y_data)\nr_squared = r_value**2\n\n# Generate regression line points\nmin_x = np.min(x_data)\nmax_x = np.max(x_data)\nx_line = np.array([min_x, max_x])\ny_line = slope * x_line + intercept\n\n# Plotting\nfig, ax = plt.subplots(figsize=(10, 7))\n\nax.scatter(x_data, y_data, color='steelblue', alpha=0.6, edgecolors='w', s=50, label='데이터 (Grade A, B)')\nax.plot(x_line, y_line, color='red', linestyle='--', linewidth=2, label='회귀선')\n\n# Add regression equation and R^2\neq_text = f'y = {slope:.4f}x + {intercept:.4f}'\nr2_text = f'$R^2$ = {r_squared:.4f}'\ntextstr = '\\n'.join((eq_text, r2_text))\n\nprops = dict(boxstyle='round', facecolor='white', alpha=0.8)\nax.text(0.95, 0.95, textstr, transform=ax.transAxes, fontsize=12,\n        verticalalignment='top', horizontalalignment='right', bbox=props)\n\nax.set_xlabel('잔류금속 (wt%)', fontsize=14)\nax.set_ylabel('IG/ID', fontsize=14)\nax.set_title('잔류금속 vs IG/ID 산점도 및 회귀 분석 (Grade C 제외)', fontsize=16)\nax.legend(loc='lower right', fontsize=12)\nax.grid(True, linestyle=':', alpha=0.5)\n\nplt.tight_layout()\noutput_file = os.path.join(OUT_DIR, \"scatter_residual_metal_vs_igid.png\")\nplt.savefig(output_file, dpi=300)\nplt.close()\n\nprint(f\"Plot saved to {output_file}\")\n```",
