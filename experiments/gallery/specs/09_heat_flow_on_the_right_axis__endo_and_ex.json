{
  "file": "data/caox.csv",
  "y2": {
    "col": "Heat Flow",
    "label": "Heat flow (W/g, exo up)",
    "flip": "none",
    "color": "#b03a2e"
  },
  "annotate": {
    "peak": false,
    "endo": {
      "type": "peak",
      "on": "y2",
      "kind": "min",
      "count": 2,
      "text": "endo {x:.0f} °C"
    },
    "exo": {
      "type": "peak",
      "on": "y2",
      "kind": "max",
      "text": "exo {x:.0f} °C"
    }
  }
}
